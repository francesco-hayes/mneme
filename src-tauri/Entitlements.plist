<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Entitlements for the hardened runtime (issue 024). Only what Mneme uses:
	audio input, for the microphone and for reading the system audio tap
	through Core Audio. No sandbox, no network, no JIT, no library exceptions.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
